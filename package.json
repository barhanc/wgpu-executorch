{
  "name": "wgpu-executorch",
  "version": "0.1.0",
  "private": true,
  "description": "Pure WebGPU inference runtime for PyTorch ExecuTorch .pte models in TypeScript",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "example": "vite example",
    "build:example": "vite build example",
    "benchmark:web": "vite utils/benchmark",
    "benchmark:live": "node utils/benchmark/profile-live.mjs",
    "benchmark:stages": "node utils/benchmark/profile-live.mjs --controlled",
    "benchmark:runntime": "node utils/benchmark/profile-live.mjs --runntime",
    "benchmark:hf": "node utils/benchmark/profile-live.mjs --hf",
    "benchmark:narrow": "node utils/benchmark/profile-live.mjs --narrow",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "pytorch",
    "executorch",
    "webgpu",
    "wgsl",
    "deep-learning",
    "browser-ml"
  ],
  "author": "Bartosz Hanc <bartosz.hanc02@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/barhanc/wgpu-executorch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/barhanc/wgpu-executorch.git"
  },
  "bugs": {
    "url": "https://github.com/barhanc/wgpu-executorch/issues"
  },
  "devDependencies": {
    "@petamoriken/float16": "^3.9.3",
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@webgpu/types": "^0.1.72",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.5.3",
    "eslint-plugin-prettier": "^5.5.6",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.8",
    "typescript": "^5.8.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "webgpu": "^0.6.1"
  }
}
